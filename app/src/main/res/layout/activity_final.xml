<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_gradiente"
    tools:context=".Final">

    <!-- FAIXA SUPERIOR -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <TextView
            android:id="@+id/textView13"
            android:layout_width="436dp"
            android:layout_height="90dp"
            android:background="@color/segunda_cor"
            android:gravity="center|start"
            android:text="   Ranking"
            android:textColor="#000000"
            android:textSize="37sp" />

    </LinearLayout>

    <!-- LINHA HORIZONTAL -->
    <View
        android:id="@+id/linha"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="15dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/linearLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NOME DO USUÁRIO -->
    <TextView
        android:id="@+id/txtNomeUsuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:gravity="end"
        android:text="Nome do usuário"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/linha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FORMA DO RESULTADO -->
    <LinearLayout
        android:id="@+id/linearLayoutAcertos"
        android:layout_width="360dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/fundo_bordasredondas"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/txtNomeUsuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ACERTOS -->
        <TextView
            android:id="@+id/txtAcertos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ACERTOS"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- NÚMERO DE ACERTOS -->
        <TextView
            android:id="@+id/txtPontuacao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- BOTÕES -->
    <LinearLayout
        android:id="@+id/linearLayoutBotoes"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/linearLayoutAcertos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- RESPONDER NOVAMENTE -->
        <ToggleButton
            android:id="@+id/togResponderNovamente"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primeira_cor"
            android:text="RESPONDER NOVAMENTE"
            android:textOff="RESPONDER NOVAMENTE"
            android:textOn="RESPONDER NOVAMENTE"
            android:textSize="24sp" />

        <!-- TELA PRINCIPAL -->
        <ToggleButton
            android:id="@+id/togTelaPrincipal"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primeira_cor"
            android:text="TELA PRINCIPAL"
            android:textOff="TELA PRINCIPAL"
            android:textOn="TELA PRINCIPAL"
            android:textSize="24sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>