<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/fundo_gradiente">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".MainActivity">

    

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="409dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:layout_editor_absoluteX="1dp"
            tools:layout_editor_absoluteY="1dp">

            <TextView
                android:id="@+id/textView13"
                android:layout_width="436dp"
                android:layout_height="90dp"
                android:background="@color/segunda_cor"
                android:gravity="center|start"
                android:text="   Início"
                android:textColor="#000000"
                android:textSize="37sp" />

        </LinearLayout>



        <ImageView
            android:id="@+id/imageView8"
            android:layout_width="178dp"
            android:layout_height="163dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout"
            app:layout_constraintVertical_bias="0.019"
            app:srcCompat="@drawable/unicid" />


        
        <!-- NOME, INTEGRANTES E LOGO -->
     

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="409dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView8">


            <!-- NOME PRINCIPAL -->

            <TextView
                android:id="@+id/textView14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Projeto em Grupo"
                android:textColor="@color/white"
                android:textSize="24sp" />


            <!-- ================================================= -->
            <!-- BOTÃO INTEGRANTES -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtIntegrantes"
                android:layout_width="221dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/fundo_integrantes"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="INTEGRANTES ▼"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- CAIXA DOS INTEGRANTES COM ROLAGEM -->
            <!-- ================================================= -->

            <ScrollView
                android:id="@+id/txtListaIntegrantes"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/fundo_integrantes"
                android:fillViewport="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="always"
                android:scrollbars="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="15dp"
                    android:text="Samira Osman Pechliye&#10;RGM: 000000"
                    android:textColor="@color/black"
                    android:textSize="18sp" />

            </ScrollView>


            <!-- ================================================= -->
            <!-- LOGO -->
            <!-- ================================================= -->

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="382dp"
                android:layout_height="181dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/quiz_image" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- ÁREA DO NOME E BOTÕES -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="430dp"
            android:background="@drawable/fundo_forma"
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
            app:layout_constraintVertical_bias="0.0">


            <!-- CAMPO DO NOME -->

            <EditText
                android:id="@+id/edtnome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="top|start"
                android:hint="Digite seu nome..."
                android:inputType="text"
                android:padding="20dp"
                android:textColor="@color/white"
                android:textSize="24sp" />


            <!-- ================================================= -->
            <!-- BOTÕES -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:orientation="horizontal">


                <!-- BOTÃO INICIAR -->

                <ToggleButton
                    android:id="@+id/toginiciar"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primeira_cor"
                    android:enabled="false"
                    android:text="INICIAR QUIZ"
                    android:textOff="INICIAR QUIZ"
                    android:textOn="INICIAR QUIZ"
                    android:textSize="24sp" />


                <!-- BOTÃO SAIR -->

                <ToggleButton
                    android:id="@+id/togsair"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primeira_cor"
                    android:text="SAIR"
                    android:textOff="SAIR"
                    android:textOn="SAIR"
                    android:textSize="24sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
